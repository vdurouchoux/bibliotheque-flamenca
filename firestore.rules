rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if request.resource.data.workspaceId is string
                   && request.resource.data.updatedAt is number;
    }
    match /shared_montages/{montageId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                           && request.resource.data.paloId is string
                           && request.resource.data.payloadJson is string
                           && request.resource.data.createdAt is number;
    }
  }
}
